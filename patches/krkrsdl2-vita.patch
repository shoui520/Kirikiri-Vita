+#ifdef KRKRVITA_RETAIL
+static bool TVPSelectRetailProjectCandidate(const tjs_string &base,
+	const tjs_char *leaf, const char *trace_stage, ttstr &selected)
+{
+	const ttstr candidate(base + leaf);
+	if(TVPCheckExistentLocalFolder(candidate))
+	{
+		selected = candidate + TJS_W("/");
+		krkrvita_boot_trace(trace_stage);
+		return true;
+	}
+	if(TVPCheckExistentLocalFile(candidate))
+	{
+		selected = candidate;
+		selected += TVPArchiveDelimiter;
+		krkrvita_boot_trace(trace_stage);
+		return true;
+	}
+	return false;
+}
+
+static void TVPSelectRetailProjectAt(const ttstr &root, ttstr &selected)
+{
+	tjs_string base = root.AsStdString();
+	if(base.empty()) return;
+	const tjs_char last = base[base.length() - 1];
+	if(last != TJS_W('/') && last != TJS_W('\\')) base += TJS_W('/');
+	TVPRetailGameRoot = TVPNormalizeStorageName(ttstr(base));
+
+	// Match native Kirikiri/Kirikiroid project discovery when the launcher
+	// supplies a game directory rather than placing the executable inside it.
+	if(TVPSelectRetailProjectCandidate(base, TJS_W("content-data"),
+		"retail-project-content-data-selected", selected)) return;
+	if(TVPSelectRetailProjectCandidate(base, TJS_W("data.xp3"),
+		"retail-project-data-xp3-selected", selected)) return;
+	if(TVPSelectRetailProjectCandidate(base, TJS_W("data.exe"),
+		"retail-project-data-exe-selected", selected)) return;
+	if(TVPSelectRetailProjectCandidate(base, TJS_W("data"),
+		"retail-project-data-directory-selected", selected)) return;
+
+	selected = base;
+	krkrvita_boot_trace("retail-project-root-selected");
+}
