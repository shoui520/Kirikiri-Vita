+	"${KRKRVITA_XP3FILTER_SOURCE}")
+string(REPLACE
+	"thread_local std::auto_ptr<XP3FilterDecoder> ret;\n\tif(!ret) ret = AddXP3Decoder();"
+	"thread_local std::unique_ptr<XP3FilterDecoder> ret;\n\tif(!ret) ret.reset(AddXP3Decoder());"
+	KRKRVITA_XP3FILTER_SOURCE "${KRKRVITA_XP3FILTER_SOURCE}")
+file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/krkrvita-generated")
+file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/krkrvita-generated/xp3filter.cpp"
+	"${KRKRVITA_XP3FILTER_SOURCE}")
