+# depends on an Android-only thread-exit hook; select Yuri's own thread-local
+# implementation for Vita without maintaining a forked copy of the file.
+file(READ "${KRKRVITA_OVERLAY_DIR}/vendor/yuri/src/plugins/xp3filter.cpp"
+	KRKRVITA_XP3FILTER_SOURCE)
