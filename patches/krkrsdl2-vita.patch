+	${KRKRVITA_OVERLAY_DIR}/vendor/yuri/src/core/sound/win32/CDDAImpl.cpp
+	${KRKRVITA_OVERLAY_DIR}/vendor/yuri/src/core/sound/win32/MIDIImpl.cpp
+	${KRKRVITA_OVERLAY_DIR}/vendor/yuri/src/core/utils/PadIntf.cpp
