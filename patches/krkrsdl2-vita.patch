 target_link_libraries(${KRKRSDL2_NAME} ${KRKRSDL2_LIBS})
+
+# A complete Kirikiri core is kept here wholesale.  Platform projects may
+# replace only the final presentation boundary instead of reimplementing TJS
+# native classes one at a time.
+if(VITA AND DEFINED KRKRVITA_OVERLAY_DIR)
+# Yuri's retail filter bridge is compiled as a unit.  Its shared decoder path
+# depends on an Android-only thread-exit hook; select Yuri's own thread-local
+# implementation for Vita without maintaining a forked copy of the file.
+file(READ "${KRKRVITA_OVERLAY_DIR}/vendor/yuri/src/plugins/xp3filter.cpp"
+	KRKRVITA_XP3FILTER_SOURCE)
+string(REPLACE "#if 1 ||" "#if 0 ||" KRKRVITA_XP3FILTER_SOURCE
+	"${KRKRVITA_XP3FILTER_SOURCE}")
+string(REPLACE
+	"thread_local std::auto_ptr<XP3FilterDecoder> ret;\n\tif(!ret) ret = AddXP3Decoder();"
+	"thread_local std::unique_ptr<XP3FilterDecoder> ret;\n\tif(!ret) ret.reset(AddXP3Decoder());"
+	KRKRVITA_XP3FILTER_SOURCE "${KRKRVITA_XP3FILTER_SOURCE}")
+file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/krkrvita-generated")
+file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/krkrvita-generated/xp3filter.cpp"
+	"${KRKRVITA_XP3FILTER_SOURCE}")
+target_sources(${KRKRSDL2_NAME} PRIVATE
+	${KRKRVITA_OVERLAY_DIR}/src/engine/vita/early_boot_trace.c
+	${KRKRVITA_OVERLAY_DIR}/src/engine/vita/vitagl_presenter.cpp
+	${KRKRVITA_OVERLAY_DIR}/src/engine/vita/VitaPvfFontRasterizer.cpp
+	${KRKRVITA_OVERLAY_DIR}/src/engine/vita/vita_input_bridge.cpp
+	${KRKRVITA_OVERLAY_DIR}/src/engine/vita/vita_launch.cpp
+	${KRKRVITA_OVERLAY_DIR}/src/engine/retail/retail_bootstrap.cpp
+	${KRKRVITA_OVERLAY_DIR}/src/engine/retail/legacy_classes.cpp
+	${KRKRVITA_OVERLAY_DIR}/src/engine/retail/xp3filter_install.cpp
+	${KRKRVITA_OVERLAY_DIR}/src/engine/retail/yuri_kag_parser.cpp
+	${KRKRVITA_OVERLAY_DIR}/src/engine/retail/yuri_menu_intf.cpp
+	${KRKRVITA_OVERLAY_DIR}/src/engine/retail/yuri_menu_impl.cpp
+	${KRKRVITA_OVERLAY_DIR}/vendor/yuri/src/plugins/ncbind/ncbind.cpp
+	${CMAKE_CURRENT_BINARY_DIR}/krkrvita-generated/xp3filter.cpp
+)
+target_include_directories(${KRKRSDL2_NAME} PRIVATE
+	${KRKRVITA_OVERLAY_DIR}/include
+	${KRKRVITA_OVERLAY_DIR}/src/engine/vita
+	${KRKRVITA_OVERLAY_DIR}/vendor/yuri/src/plugins
+	${KRKRVITA_OVERLAY_DIR}/vendor/yuri/src/plugins/ncbind
+	${KRKRVITA_OVERLAY_DIR}/vendor/yuri/src/core/environ
+	${KRKRVITA_OVERLAY_DIR}/vendor/yuri/src/core/utils
+	${KRKRVITA_OVERLAY_DIR}/vendor/yuri/src/core/visual
+	${KRKRVITA_OVERLAY_DIR}/vendor/yuri/src/core/visual/win32
+)
+target_compile_definitions(${KRKRSDL2_NAME} PRIVATE
+	KRKRVITA_VITAGL=1
+	KRKRVITA_RETAIL=1
+	KRKRVITA_PVF_FONT=1
+)
+target_link_libraries(${KRKRSDL2_NAME}
+	vitaGL vitashark SceShaccCgExt SceShaccCg_stub taihen_stub mathneon
+	SceKernelDmacMgr_stub
+	ScePvf_stub
+)
+endif()
 if(${CMAKE_VERSION} VERSION_GREATER_EQUAL "3.16.0")
